// Ícone e informações do executável
1 ICON "app.ico"
1 VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "FileDescription", "Kinect 3D Studio para PC"
      VALUE "ProductName", "Kinect 3D Studio"
      VALUE "FileVersion", "0.4.0"
      VALUE "ProductVersion", "0.4.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
